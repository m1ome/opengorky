#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 m_18 [[attribute(0)]];
};

vertex main0_out main0(main0_in in [[stage_in]])
{
    main0_out out = {};
    out.gl_Position = float4((in.m_18.x * 0.00390625) - 1.0, 1.0 - (in.m_18.y * 0.00390625), 0.0, 1.0);
    return out;
}

